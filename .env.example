# MySQL 8 연결 시 설정. 입력하지 않으면 재시작 시 사라지는 H2 개발 DB를 사용한다.
DB_URL=jdbc:mysql://127.0.0.1:3309/safe_school_road?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=localdev
REMEMBER_ME_KEY=replace-with-a-long-random-secret
TMAP_APP_KEY=
TMAP_DAILY_LIMIT=950
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
VWORLD_API_KEY=
SAFEMAP_API_KEY=
# AI 안내문. false 또는 키 미설정이면 기본 문장으로 저장한다.
GUIDE_AI_ENABLED=false
GROQ_API_KEY=
GUIDE_AI_MODEL=openai/gpt-oss-20b
# prod,https 실행 때 서비스 도메인 인증서를 담은 PKCS12 파일을 지정한다.
# TLS_KEY_STORE=file:/etc/safe-school-road/server.p12
# TLS_KEY_STORE_PASSWORD=
# SERVER_ADDRESS=127.0.0.1
