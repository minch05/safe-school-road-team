# API 키 양식 — 이 파일은 GitHub에 올려도 된다 (실제 키는 넣지 않는다)
# 사용법: 이 파일을 복사해 .env 를 만들고, .env 에만 실제 키를 넣는다.
# 형식: 이름=값  (= 앞뒤에 띄어쓰기 없이, 따옴표 없이)

# ── 경로 계산 ──────────────────────────────
# TMAP 보행자 경로 (SK open API). 서버에서만 쓴다. 하루 1,000건 한도
TMAP_APP_KEY=

# ── 지도 ───────────────────────────────────
# VWorld 배경지도·지오코더(주소 → 좌표)
# 지도는 브라우저에서 불러오므로 사용자에게 키가 보인다 → VWorld 사이트에서 사용할 도메인(localhost, 배포 주소)을 등록해 둔다
VWORLD_API_KEY=

# ── 공공데이터 ─────────────────────────────
# 생활안전지도 (범죄주의구간 등 WMS 이미지)
SAFEMAP_API_KEY=
# 공공데이터포털 (data.go.kr) — "일반 인증키(Decoding)" 값을 넣는다
DATA_GO_KR_SERVICE_KEY=
# TAAS 교통사고분석시스템 (사고다발지역)
TAAS_API_KEY=
# 서울 열린데이터광장 (data.seoul.go.kr) — 공공데이터포털과 다른 키. 서울 횡단보도 등
SEOUL_OPEN_API_KEY=

# ── AI (안내문·경로 차이 설명) ──────────────────
# Groq API 키 (console.groq.com, 카드 등록 없음). 메인 AI. Data Controls 에서 Inference APIs ZDR 을 켜 둔다
GROQ_API_KEY=
# Gemini API 키 (Google AI Studio 에서 발급). Groq 가 한도에 닿을 때 쓰는 예비
LLM_API_KEY=
# 둘 다 비어 있으면 AI 없이 정해진 문장으로 안내문을 만든다
# 모델 순서. 비우면 application.yml 의 app.llm.chain 기본값 ("회사:모델,회사:모델")
# LLM_CHAIN=

# ── 웹 푸시 ─────────────────────────────────
# 출발·도착 알림용 VAPID 키 (아이폰 시험에서 쓴 키는 재사용하지 않음). 만드는 법:
#   openssl ecparam -name prime256v1 -genkey -noout -out vapid.pem
#   공개키: openssl ec -in vapid.pem -pubout -outform DER | tail -c 65 | base64 | tr '+/' '-_' | tr -d '=\n'
#   비밀키: openssl ec -in vapid.pem -outform DER | dd bs=1 skip=7 count=32 | base64 | tr '+/' '-_' | tr -d '=\n'
# VAPID_SUBJECT 는 푸시 서버가 연락할 곳 (mailto:주소 또는 https 주소)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── 프로젝트 전용 MySQL 8.4 (Docker, 기존 MySQL과 분리) ──
# DB_PASSWORD와 MYSQL_ROOT_PASSWORD에는 서로 다른 임의 비밀번호를 설정한다.
# docker compose up -d --wait
DB_URL=jdbc:mysql://127.0.0.1:3308/safe_school_road?createDatabaseIfNotExist=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=safe_school_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── 운영·API 문서 ────────────────────────────
# API_DOCS_ENABLED=true   # 로컬 기본 true, prod 기본 false
# SPRING_PROFILES_ACTIVE=prod
# 보행어린이 사고 API 포함 여부 (승인 확인, 기본 true)
# RISK_INCLUDE_CHILD_PEDESTRIAN=true

# 네이버 Maps 인증 정보 (Dynamic Map / Geocoding / Reverse Geocoding)
# 해당 서비스의 인증 정보에서 복사해 = 뒤에 입력하세요.
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=

# NAVER API HUB 인증 정보 (지역 검색)
# 해당 서비스의 인증 정보에서 복사해 = 뒤에 입력하세요.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 공개자료 보관 (prod 기본 public-data 경로, 백업은 별도 영구 경로)
# PUBLIC_DATA_DIR=/var/lib/safe-school-road/public-data
# PUBLIC_DATA_BACKUP_DIR=/var/lib/safe-school-road/public-data-backups

# 검토한 서울시 도보 네트워크 파일과 SHA-256 (둘 다 설정해야 활성화)
# WALK_NETWORK_FILE=/absolute/ascii/path/walk-network.json
# WALK_NETWORK_SHA256=
